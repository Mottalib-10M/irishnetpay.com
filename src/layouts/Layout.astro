---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
// §11 : la vignette de partage. Son nom suit le chemin de la page, ce que le
// script og-cards.py de la trame respecte. Sans elle, une page partagée sortait
// en lien nu (relevé du 2026-09-26).
const cheminOg = (canonical ?? '/').replace(/^\/+|\/+$/g, '').replace(/\//g, '-');
const ogImage = `https://irishnetpay.com/og/${cheminOg || 'accueil'}.png`;
const siteUrl = 'https://irishnetpay.com';
const pageUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Radif Partners" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Irish Take-Home Pay Calculator",
      "url": siteUrl,
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
      "description": description,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Take Home Pay Ireland",
      "url": "https://irishnetpay.com",
      "logo": "https://irishnetpay.com/favicon.svg",
      "founder": {
        "@type": "Organization",
        "name": "Radif Partners"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Radif Partners",
      "jobTitle": "Personal Finance & Taxation Expert",
      "description": "Publisher of calculators and practical guides",
      "url": "https://irishnetpay.com/about/"
    })} />

    <script defer data-domain="irishnetpay.com" src="https://plausible.io/js/script.js"></script>
    <!--
      Pas de GA4 : l'identifiant etait reste a l'etat de gabarit
      (G-XXXXXXXXXX), donc deux requetes vers googletagmanager a chaque
      page pour une mesure qui n'arrivait nulle part.
    -->
</head>
  <body class="min-h-screen bg-surface text-gray-900 font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <header class="bg-white border-b border-border">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl hover:text-primary-dark transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          irishnetpay.com
        </a>

        <!-- Desktop navigation -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          <a href="/" class="text-gray-600 hover:text-primary transition-colors">Calculator</a>
          <a href="/guides/" class="text-gray-600 hover:text-primary transition-colors">Guides</a>
          <a href="/average-salary-ireland/" class="text-gray-600 hover:text-primary transition-colors">Average Salary</a>
          <a href="/minimum-wage-ireland/" class="text-gray-600 hover:text-primary transition-colors">Minimum Wage</a>
          <a href="/faq/" class="text-gray-600 hover:text-primary transition-colors">FAQ</a>
        </nav>

        <!-- Mobile hamburger button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden relative w-8 h-8 flex flex-col items-center justify-center gap-1.5"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <span class="hamburger-line block w-6 h-0.5 bg-gray-700 rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-gray-700 rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-gray-700 rounded transition-all duration-300 origin-center"></span>
        </button>
      </div>

      <!-- Mobile navigation panel -->
      <nav
        id="mobile-menu"
        class="md:hidden hidden border-t border-border bg-white"
      >
        <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col gap-3 text-sm">
          <a href="/" class="text-gray-600 hover:text-primary transition-colors py-1">Calculator</a>
          <a href="/guides/" class="text-gray-600 hover:text-primary transition-colors py-1">Guides</a>
          <a href="/average-salary-ireland/" class="text-gray-600 hover:text-primary transition-colors py-1">Average Salary</a>
          <a href="/minimum-wage-ireland/" class="text-gray-600 hover:text-primary transition-colors py-1">Minimum Wage</a>
          <a href="/faq/" class="text-gray-600 hover:text-primary transition-colors py-1">FAQ</a>
          <a href="/legal/" class="text-gray-600 hover:text-primary transition-colors py-1">Legal Notice</a>
          <a href="/privacy/" class="text-gray-600 hover:text-primary transition-colors py-1">Privacy Policy</a>
        </div>
      </nav>
    </header>
    <main id="main-content" class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="bg-white border-t border-border mt-12">
      <div class="max-w-5xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-gray-600">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Tools</h3>
            <ul class="space-y-2">
              <li><a href="/" class="hover:text-primary">Salary Calculator</a></li>
              <li><a href="/guides/" class="hover:text-primary">Guides</a></li>
              <li><a href="/average-salary-ireland/" class="hover:text-primary">Average Salary Ireland</a></li>
              <li><a href="/minimum-wage-ireland/" class="hover:text-primary">Minimum Wage Ireland</a></li>
              <li><a href="/faq/" class="hover:text-primary">FAQ</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Official Resources</h3>
            <ul class="space-y-2">
              <li><a href="https://www.revenue.ie" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Revenue.ie</a></li>
              <li><a href="https://www.citizensinformation.ie" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Citizens Information</a></li>
              <li><a href="https://www.gov.ie" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Gov.ie</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Information</h3>
            <ul class="space-y-2">
              <li><a href="/legal/" class="hover:text-primary">Legal Notice</a></li>
              <li><a href="/privacy/" class="hover:text-primary">Privacy Policy</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-200 text-xs text-gray-500">
          <p>Independent, free salary calculator. Results are estimates only. 2026 tax rates.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script is:inline>
      (function() {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;

        btn.addEventListener('click', function() {
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');

          var lines = btn.querySelectorAll('.hamburger-line');
          if (!expanded) {
            // Transform to X
            lines[0].style.transform = 'translateY(4px) rotate(45deg)';
            lines[1].style.opacity = '0';
            lines[2].style.transform = 'translateY(-4px) rotate(-45deg)';
          } else {
            // Revert to hamburger
            lines[0].style.transform = '';
            lines[1].style.opacity = '1';
            lines[2].style.transform = '';
          }
        });
      })();
    </script>
  </body>
</html>
