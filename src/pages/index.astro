---
import Layout from '../layouts/Layout.astro';
import SalaryCalculator from '../components/SalaryCalculator';
import PayBreakdown from '../components/PayBreakdown.astro';
import Clamp from '../components/Clamp.astro';
import { USC_BANDS, USC_EXEMPTION, PRSI_RATE_JAN_SEP, PRSI_RATE_OCT_DEC, PRSI_WEEKLY_THRESHOLD, SRCOP, TAX_CREDITS } from '../lib/tax-rates-2026';
import { JA, SPC, FAMILY_LEAVE, JPRB, STAMP_DUTY, HTB } from '../lib/welfare-2026';

const eur = (x: number) => new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: Number.isInteger(x) ? 0 : 2 }).format(x);
const pc = (x: number) => `${Math.round(x * 10000) / 100}%`;

/* §21 : le bloc citable de la page d'accueil, replie a l'ecran (§26). */
const chapeau = `Your Irish take-home pay for 2026 is gross salary minus three separate charges, each with its own rules: income tax at 20% up to your standard rate cut-off point (${eur(SRCOP.single)} for a single person) and 40% above, reduced by tax credits; the Universal Social Charge, charged in bands once income passes ${eur(USC_EXEMPTION)}; and PRSI at ${pc(PRSI_RATE_JAN_SEP)} of gross pay above ${eur(PRSI_WEEKLY_THRESHOLD)} a week, rising to ${pc(PRSI_RATE_OCT_DEC)} on 1 October 2026. The calculator below applies all three to your salary, status and pension contribution. The site goes further than the official pages, which list the rules without applying them: every page works out the figure for your own case, from the payslip to the social welfare payments (Jobseeker's, Illness and Maternity Benefit, Working Family Payment, Carer's Allowance, State Pension) and the cost of buying a home (Stamp Duty and Help to Buy), each with its Revenue or Department of Social Protection source and the date it was read.`;

/* §7 : une seule liste pour la FAQ visible et pour le balisage FAQPage. */
const faqs = [
  { q: 'What is the income tax rate in Ireland in 2026?', a: `Ireland has two income tax rates: 20% on income up to the standard rate cut-off point, ${eur(SRCOP.single)} for a single person and ${eur(SRCOP.married_one_income)} for a married couple with one income, and 40% on the rest. Tax credits are then deducted from the tax itself, ${eur(TAX_CREDITS.personal_single + TAX_CREDITS.employee_paye)} for a single employee with the personal and employee credits.` },
  { q: 'What is USC and how is it calculated?', a: `The Universal Social Charge is a separate charge on gross income. Nothing is due if total income is ${eur(USC_EXEMPTION)} or less; above that, the whole income is charged: ${pc(USC_BANDS[0].rate)} on the first ${eur(USC_BANDS[0].max)}, ${pc(USC_BANDS[1].rate)} up to ${eur(USC_BANDS[1].max)}, ${pc(USC_BANDS[2].rate)} up to ${eur(USC_BANDS[2].max)} and ${pc(USC_BANDS[3].rate)} above. Tax credits do not reduce it.` },
  { q: 'What PRSI rate do employees pay?', a: `Most employees pay Class A PRSI at ${pc(PRSI_RATE_JAN_SEP)} of gross earnings until 30 September 2026 and ${pc(PRSI_RATE_OCT_DEC)} from 1 October. Nothing is charged when weekly pay is ${eur(PRSI_WEEKLY_THRESHOLD)} or less, and a tapered credit softens the step just above it. There is no upper limit on the earnings it is charged on.` },
  { q: 'How much would I get on Jobseeker’s if I lost my job?', a: `Someone fully unemployed with at least two years of paid PRSI gets Jobseeker’s Pay-Related Benefit: ${pc(JPRB.long[0].rate)} of previous weekly pay, capped at ${eur(JPRB.long[0].cap)}, for the first 13 weeks, then lower steps. Without enough PRSI, Jobseeker’s Allowance pays up to ${eur(JA.personal)} a week after a means test. The social welfare section calculates both.` },
  { q: 'Does this site cover the State Pension and maternity pay?', a: `Yes. The State Pension (Contributory) page applies the Total Contributions Approach and the 2026 blend with the yearly average to your record, up to ${eur(SPC.max)} a week. The Maternity Benefit page compares the standard ${eur(FAMILY_LEAVE.rate)} a week with the Illness Benefit rate for your family, and pays the higher, as the Department does.` },
  { q: 'How much Stamp Duty will I pay on a home?', a: `${pc(STAMP_DUTY.bands[0].rate)} of the price up to ${eur(STAMP_DUTY.bands[0].upTo)}, ${pc(STAMP_DUTY.bands[1].rate)} up to ${eur(STAMP_DUTY.bands[1].upTo)} and ${pc(STAMP_DUTY.bands[2].rate)} above, with the VAT taken out of a new home's price first. A first-time buyer of a new home may also claim up to ${eur(HTB.max)} under Help to Buy. Both have their own calculator on this site.` },
];
---

<Layout
  title="Take-Home Pay Ireland 2026: Income Tax, USC & PRSI"
  description="Take-home pay in Ireland for 2026: income tax, USC, PRSI, tax credits and pension relief, using the Revenue rates and thresholds in force for this year."
>
  <div class="space-y-10">
    <div class="text-center max-w-5xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Irish Take-Home Pay Calculator 2026
      </h1>
      <Clamp id="home-intro" text={chapeau} sentences={1} class="text-lg text-gray-600 leading-relaxed text-left" />
    </div>

    <SalaryCalculator client:idle />

    <section class="max-w-5xl mx-auto" aria-labelledby="beyond-payslip">
      <h2 id="beyond-payslip" class="text-2xl font-bold text-gray-900 mb-4">Beyond the payslip: benefits, pension and buying a home</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/jobseekers-benefit/" class="font-semibold text-primary hover:underline">Jobseeker's Benefit</a><span class="block text-gray-600 mt-1">Pay-related rate after a lay-off, up to {eur(JPRB.long[0].cap)} a week.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/jobseekers-allowance/" class="font-semibold text-primary hover:underline">Jobseeker's Allowance</a><span class="block text-gray-600 mt-1">The means test with part-time pay, a partner and savings.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/illness-benefit/" class="font-semibold text-primary hover:underline">Illness Benefit</a><span class="block text-gray-600 mt-1">Weekly rate from 2024 earnings, waiting days, duration.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/maternity-benefit/" class="font-semibold text-primary hover:underline">Maternity and Paternity Benefit</a><span class="block text-gray-600 mt-1">{eur(FAMILY_LEAVE.rate)} a week, or more with dependants.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/working-family-payment/" class="font-semibold text-primary hover:underline">Working Family Payment</a><span class="block text-gray-600 mt-1">The weekly top-up from your gross pay.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/carers-allowance/" class="font-semibold text-primary hover:underline">Carer's Allowance</a><span class="block text-gray-600 mt-1">Rate after the means test, new disregard included.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/social-welfare/state-pension/" class="font-semibold text-primary hover:underline">State Pension (Contributory)</a><span class="block text-gray-600 mt-1">Your rate from your PRSI record, up to {eur(SPC.max)}.</span></li>
        <li class="bg-white border border-border rounded-xl p-4"><a href="/stamp-duty-ireland/" class="font-semibold text-primary hover:underline">Stamp Duty</a> and <a href="/help-to-buy-ireland/" class="font-semibold text-primary hover:underline">Help to Buy</a><span class="block text-gray-600 mt-1">What a home costs in duty, and what Help to Buy refunds.</span></li>
      </ul>
      <p class="mt-4 text-sm"><a href="/social-welfare/" class="text-primary hover:underline">All 2026 social welfare rates in one table</a> · <a href="/about/" class="text-primary hover:underline">About</a> · <a href="/methodology/" class="text-primary hover:underline">Methodology</a></p>
    </section>

    <div class="prose prose-slate max-w-none">

      <h2>How Irish salary deductions work in 2026</h2>
      <p>
        When you receive your gross salary in Ireland, three separate deductions are applied before
        you receive your net (take-home) pay: income tax, the Universal Social Charge (USC), and
        Pay Related Social Insurance (PRSI). Each operates under its own rules, thresholds, and
        rates. Understanding how these work together is essential for anyone employed in Ireland,
        whether you are a permanent resident, a recent arrival, or an employer calculating payroll.
      </p>
      <p>
        Our calculator processes all three deductions simultaneously, applying the correct rates
        and thresholds for 2026 as published by Revenue. The calculation runs entirely in your
        browser - no salary data is transmitted or stored on any server. You can share your results
        by copying the URL, which encodes your inputs in the address bar.
      </p>

      <h2>Income tax in Ireland</h2>
      <p>
        Ireland operates a two-rate income tax system. The standard rate is 20%, applied to income
        up to the Standard Rate Cut-Off Point (SRCOP). Income above this threshold is taxed at the
        higher rate of 40%. The SRCOP depends on your filing status: €44,000 for a single person,
        €53,000 for a married couple with one income, and €88,000 combined for a married couple
        where both spouses earn (€53,000 plus the second income, up to a further €35,000). Single parents
        receive an increased cut-off of €48,000.
      </p>
      <p>
        The gross income tax calculated using these rates is then reduced by your tax credits.
        Every PAYE worker receives two main credits: the Personal Tax Credit (€2,000 for a single
        person, €4,000 for a married couple) and the Employee (PAYE) Tax Credit of €2,000. These
        credits are deducted directly from your tax liability, not from your income. If your
        credits exceed your tax liability, the excess is not refunded - your income tax simply
        reduces to zero.
      </p>
      <p>
        Additional credits are available depending on your circumstances. Single parents qualify
        for the Single Person Child Carer Credit (SPCCC) of €1,900. Married couples where one
        spouse is a home carer can claim the Home Carer Tax Credit of €1,950 (subject to income
        limits on the home carer's own earnings). Other credits include the Rent Tax Credit, the
        Flat Rate Expenses deduction for certain occupations, and medical expense relief.
      </p>

      <h2>The Universal Social Charge (USC)</h2>
      <p>
        The USC was introduced in 2011 to replace the Health Levy and Income Levy. It is a
        progressive charge applied to gross income before pension deductions. In 2026, income
        up to €13,000 is fully exempt from USC. For those above this threshold, four bands apply:
        0.5% on the first €12,012, 2% on the next €16,688 (up to €28,700), 3% on the next
        €41,344 (up to €70,044), and 8% on all income above €70,044.
      </p>
      <p>
        The USC differs from income tax in several important ways. It cannot be reduced by tax
        credits - the charge is applied directly to your income with no offsets. It applies to
        all income, not just employment income, and the bands are the same regardless of filing
        status. For high earners, the USC adds a significant layer of taxation: someone earning
        €100,000 pays approximately €4,031 in USC annually, on top of their income tax and PRSI.
      </p>
      <p>
        Reduced USC rates apply in specific circumstances. Medical card holders who earn less than
        €60,000 pay a maximum rate of 2%. Individuals aged 70 and over with income under €60,000
        also qualify for reduced rates. These special rates are not included in our standard
        calculator but can be accounted for using the additional credits input.
      </p>

      <h2>PRSI - Pay Related Social Insurance</h2>
      <p>
        PRSI funds Ireland's social insurance system, which provides benefits including the State
        Pension (Contributory), Jobseeker's Benefit, Illness Benefit, and Maternity Benefit.
        Most employees fall under Class A, which requires a contribution of 4.2% of gross earnings, rising to 4.35% from 1 October 2026.
        No PRSI is payable if your weekly income is at or below €352 (approximately €18,304 annually).
      </p>
      <p>
        For those just above the threshold (between €352.01 and €424 per week), a tapered PRSI
        credit applies. This credit of up to €12 per week is gradually withdrawn as income rises,
        ensuring a smooth transition rather than a sudden jump in contributions. Above €424 per
        week, the full rate applies on all earnings with no upper limit.
      </p>
      <p>
        Employers also pay PRSI on behalf of their employees. The employer's rate is 9% for
        employees earning up to €552 per week, and 11.25% for those earning above this threshold.
        This employer contribution is not deducted from the employee's pay but adds to the total
        cost of employment. For someone earning €50,000, the employer pays approximately €5,644
        in employer PRSI over 2026, making the total cost of employment roughly €55,644.
      </p>

      <h2>Filing status and its impact on your net pay</h2>
      <p>
        Your filing status is one of the most significant factors in determining your take-home
        pay. A single person earning €60,000 faces income tax on €16,000 (the portion above the
        €44,000 SRCOP) at the higher 40% rate. A married couple with one income earning the same
        amount sees only €7,000 taxed at 40% (SRCOP of €53,000), and receives higher tax credits
        plus the Home Carer Credit. On €60,000 the difference in net pay is about €5,750 per year.
      </p>
      <p>
        For married couples where both spouses work, the combined SRCOP of €88,000 is allocated
        between them: one spouse can use up to €53,000 and the other up to €35,000. The increase
        for the second income cannot be transferred, so it is limited to what the lower earner
        actually earns, which matters when incomes are unequal.
      </p>

      <h2>Pension contributions and tax relief</h2>
      <p>
        Contributions to an approved occupational pension scheme or a Personal Retirement Savings
        Account (PRSA) qualify for tax relief at your marginal rate. If you earn €60,000 and
        contribute 5% (€3,000) to a pension, that €3,000 is deducted from your taxable income
        before applying the income tax bands. At the 40% higher rate, this saves you €1,200 in
        income tax annually. The pension contribution does not reduce your USC or PRSI liability.
      </p>
      <p>
        Revenue sets age-related limits on the percentage of earnings eligible for pension tax
        relief: 15% for under-30s, 20% for ages 30-39, 25% for ages 40-49, 30% for ages 50-54,
        35% for ages 55-59, and 40% for ages 60 and over. The maximum earnings limit for pension
        relief is €115,000 regardless of actual salary. Our calculator applies the pension
        deduction to your taxable income to show the tax saving effect.
      </p>

      <h2>Minimum wage and living wage in Ireland</h2>
      <p>
        The national minimum wage in Ireland for 2026 is €14.15 per hour. For a full-time worker
        on a 39-hour week, this translates to a gross annual salary of €28,696.
        After deductions, the take-home pay is €25,347, or about €2,112 per month.
        The income tax liability at this level is minimal thanks to tax credits, though USC and
        PRSI still apply.
      </p>
      <p>
        The Living Wage Technical Group has recommended a living wage of €14.80 per hour for 2026,
        reflecting the cost of living in Ireland. This would provide a gross annual salary of
        €30,014 and a net monthly pay of €2,192. The gap between the minimum
        wage and the living wage highlights the challenge faced by lower-paid workers, particularly
        in cities with high rental costs.
      </p>

      <h2>Comparing Ireland's tax system internationally</h2>
      <p>
        Ireland's effective tax rates for middle-income earners are broadly in line with other
        western European countries, though the structure differs. The 40% higher rate kicks in at a
        relatively low threshold compared to countries like the UK (40% at £50,270) or Germany
        (42% at approximately €62,810). However, Ireland's tax credit system is generous, and the
        USC - while adding to the burden - is lower than equivalent social charges in France or
        Belgium.
      </p>
      <p>
        For high earners, Ireland's combined marginal rate (income tax 40% + USC 8% + PRSI 4.2% = 52.2%)
        is among the highest in the OECD. This compares with approximately 45% in the UK, 47.5%
        in Germany, and 55% in Sweden. However, Ireland's relatively low employer PRSI
        (11.25% vs 30-40% in France) makes the total cost of employment competitive for businesses.
      </p>

      <h2 id="faq">Frequently asked questions</h2>
      {faqs.map((f) => (
        <details>
          <summary><strong>{f.q}</strong></summary>
          <p>{f.a}</p>
        </details>
      ))}
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      })} />
    </div>
  </div>
  <PayBreakdown
    brut={45000}
    libelle={'the median full-time salary of €45,000'}
  />
</Layout>
